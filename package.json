{
  "name": "figma-to-code",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "build": "pnpm --dir apps/plugin build",
    "build:watch": "pnpm --dir apps/plugin build:watch",
    "dev": "pnpm --dir apps/plugin dev",
    "dev:debug": "pnpm --dir apps/debug dev",
    "lint": "turbo run lint --log-order=grouped --output-logs=errors-only",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "eslint-config-custom": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.3",
    "tsx": "^4.23.1",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3"
  }
}
